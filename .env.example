DISCORD_TOKEN=
# Optional: register commands to one server (instant) instead of globally
DISCORD_GUILD_ID=

# Role ids allowed to request, comma separated. Empty = everyone
DISCORD_MOVIE_ROLES=
DISCORD_TV_ROLES=
# Channel ids where /request works. Empty = all channels
DISCORD_MONITORED_CHANNELS=
# Allow requests by private message. Roles and channels are not checked there.
# Commands become global, which can take up to an hour to show up.
DISCORD_ALLOW_DMS=false
# Only the requester sees the request messages
DISCORD_HIDE_REQUESTS=true

# off | dm | channels
NOTIFICATION_MODE=dm
# Channel ids, needed for NOTIFICATION_MODE=channels
NOTIFICATION_CHANNELS=
# Notify requesters automatically when their request is downloaded.
# When false they only get notified if they press "Notify me".
NOTIFY_REQUESTERS=true

# Leave RADARR_URL or SONARR_URL empty to disable that side.
# Include the URL base if you use one, e.g. http://radarr:7878/radarr
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
# Optional: name or id, defaults to the first one in Radarr
RADARR_QUALITY_PROFILE=
# Optional: defaults to the first root folder in Radarr
RADARR_ROOT_FOLDER=
# announced | inCinemas | released
RADARR_MINIMUM_AVAILABILITY=released
# Optional: comma-separated existing tag labels
RADARR_TAGS=

SONARR_URL=http://sonarr:8989
SONARR_API_KEY=
SONARR_QUALITY_PROFILE=
SONARR_ROOT_FOLDER=
# standard | daily | anime
SONARR_SERIES_TYPE=standard
SONARR_SEASON_FOLDERS=true
SONARR_TAGS=
