DISCORD_TOKEN=
# Optional: register commands to one server (instant) instead of globally
DISCORD_GUILD_ID=

# Leave RADARR_URL or SONARR_URL empty to disable that side.
# Include the URL base if you use one, e.g. http://radarr:7878/radarr
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
# Optional: name or id, defaults to the first one in Radarr
RADARR_QUALITY_PROFILE=
# Optional: defaults to the first root folder in Radarr
RADARR_ROOT_FOLDER=
# announced | inCinemas | released
RADARR_MINIMUM_AVAILABILITY=released
# Optional: comma-separated existing tag labels
RADARR_TAGS=

SONARR_URL=http://sonarr:8989
SONARR_API_KEY=
SONARR_QUALITY_PROFILE=
SONARR_ROOT_FOLDER=
# standard | daily | anime
SONARR_SERIES_TYPE=standard
SONARR_SEASON_FOLDERS=true
SONARR_TAGS=
